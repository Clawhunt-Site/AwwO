{
  "name": "@superclaw/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SuperClaw Node gateway — external front door that wraps the vendored upstream server as a loopback-only internal dependency.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
