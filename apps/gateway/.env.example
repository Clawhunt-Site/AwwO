# One planner schema for development, staging and production.
# These are process environment settings; this example is not loaded automatically.
APP_ENV=development
# Empty: codex in development, disabled in staging/production.
# Explicit options: codex | disabled. Enable non-development only on a configured host.
SUPERCLAW_CANVAS_PLANNER_PROVIDER=
# Installed native Codex executable, known npm wrapper, or command resolved from PATH.
SUPERCLAW_CANVAS_PLANNER_CLI_PATH=codex
# Empty inherits the actual CLI default model; no browser-provided model override.
SUPERCLAW_CANVAS_PLANNER_MODEL=
SUPERCLAW_CANVAS_PLANNER_TIMEOUT_MS=120000
# Read-only host Codex model/list uses the same CLI path and inherited CODEX_HOME.
# Same schema in development/staging/production; no API key is copied into the browser.
# Each query is bounded (1000-30000 ms); concurrent reads share one process, no stale cache.
SUPERCLAW_CODEX_CATALOG_TIMEOUT_MS=8000
# Match the web /gateway-api proxy when running the local preview.
SUPERCLAW_GATEWAY_PORT=8796
# Local previews should set this to a new isolated automation store path.
SUPERCLAW_GATEWAY_AUTOMATION_FILE=
