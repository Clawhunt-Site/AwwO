# ── Telemetry collection server (operator side) ─────────────────────────────
# Copy to .env and adjust. The local→prod switch is ONE variable: DATABASE_URL.

# Local mock (zero infra — SQLite file, no Docker needed):
TELEMETRY_DATABASE_URL=sqlite:///./telemetry.db
TELEMETRY_ENV=local
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8900
# Local dev may leave the tokens empty (accepts any client, logged loudly).
# Clients (devices) hold the INGEST token. Operators query/delete with the
# QUERY token — the two MUST differ so a client can't read/delete the dataset.
TELEMETRY_INGEST_TOKEN=
TELEMETRY_QUERY_TOKEN=
TELEMETRY_TIER_C_RETENTION_DAYS=7
TELEMETRY_RETENTION_INTERVAL_SECONDS=3600

# Production (same server code — just change these):
#   TELEMETRY_ENV=production
#   TELEMETRY_DATABASE_URL=postgresql://telemetry:CHANGE_ME@db:5432/telemetry
#   TELEMETRY_INGEST_TOKEN=<a-long-random-shared-secret>   # REQUIRED in production
#   TELEMETRY_QUERY_TOKEN=<a-DIFFERENT-long-random-secret> # REQUIRED in production
#   TELEMETRY_HOST=0.0.0.0

# ── Install-side client (the SuperClaw end that uploads) ─────────────────────
# Set these on each install/device. Default OFF — also needs `superclaw
# telemetry enable` (or SUPERCLAW_TELEMETRY_ENABLED=1) to actually upload.
#   SUPERCLAW_TELEMETRY_ENDPOINT=http://127.0.0.1:8900     # local mock
#   SUPERCLAW_TELEMETRY_ENDPOINT=https://telemetry.example.com   # production
#   SUPERCLAW_TELEMETRY_TOKEN=<same shared secret as TELEMETRY_INGEST_TOKEN>
#   SUPERCLAW_TELEMETRY_ENABLED=1     # enable without an interactive consent step
#   SUPERCLAW_TELEMETRY_KILL=1        # emergency: force OFF, overrides everything
