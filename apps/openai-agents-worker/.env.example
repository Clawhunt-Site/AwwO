# Load this file only in the worker process. All three environments use this schema.
APP_ENV=development
AWWO_OPENAI_AGENTS_HOST=127.0.0.1
AWWO_OPENAI_AGENTS_PORT=8098
AWWO_OPENAI_AGENTS_TOKEN=replace-with-a-unique-random-internal-token-at-least-32-characters
# Provider is openai for both OpenAI and compatible endpoints; not Anthropic native.
AWWO_OPENAI_AGENTS_PROVIDER=openai
AWWO_OPENAI_AGENTS_MODEL=replace-with-a-provider-model-id
AWWO_OPENAI_AGENTS_BASE_URL=https://api.openai.com/v1
AWWO_OPENAI_AGENTS_API_KEY=replace-with-an-environment-specific-provider-key
# chat_completions (compatible endpoints) or responses (Responses-capable endpoints).
AWWO_OPENAI_AGENTS_PROTOCOL=chat_completions
AWWO_OPENAI_AGENTS_CONTEXT_WINDOW=32768
AWWO_OPENAI_AGENTS_MAX_TOKENS=4096
AWWO_OPENAI_AGENTS_TIMEOUT_MS=120000
AWWO_OPENAI_AGENTS_CANCEL_GRACE_MS=2000
AWWO_OPENAI_AGENTS_MAX_CONCURRENCY=4
AWWO_OPENAI_AGENTS_MAX_OUTPUT_BYTES=1048576
# Additional profiles; default model above remains required. Keys are env references.
AWWO_OPENAI_AGENTS_MODELS_JSON=[]
# Example (set SECOND_MODEL_KEY in the private worker environment first):
# AWWO_OPENAI_AGENTS_MODELS_JSON=[{"id":"second","provider":"openai","model":"replace-model-id","baseURL":"https://models.example.invalid/v1","apiKeyEnv":"SECOND_MODEL_KEY","protocol":"responses","contextWindow":32768,"maxTokens":4096}]
# Both this service allowlist and the internal request must select a tool.
AWWO_OPENAI_AGENTS_TOOLS_JSON=[]
# To enable the complete safe registry: ["calculator","current_time"]
# In staging/production use separate tokens/keys and HTTPS, or loopback HTTP only.
# Optional Go-side endpoint pair (belongs in API env, not this worker env):
# AWWO_OPENAI_AGENTS_URL=http://127.0.0.1:8098
# AWWO_OPENAI_AGENTS_TOKEN=<same dedicated internal token as this worker>
