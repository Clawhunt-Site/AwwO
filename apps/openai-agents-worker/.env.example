# Load this file only in the worker process. All three environments use this schema.
APP_ENV=development
AWWO_OPENAI_AGENTS_HOST=127.0.0.1
AWWO_OPENAI_AGENTS_PORT=8098
AWWO_OPENAI_AGENTS_TOKEN=replace-with-a-unique-random-internal-token-at-least-32-characters
# Provider is openai for both OpenAI and compatible endpoints; not Anthropic native.
AWWO_OPENAI_AGENTS_PROVIDER=openai
AWWO_OPENAI_AGENTS_MODEL=replace-with-a-provider-model-id
AWWO_OPENAI_AGENTS_BASE_URL=https://api.openai.com/v1
AWWO_OPENAI_AGENTS_API_KEY=replace-with-an-environment-specific-provider-key
# chat_completions (compatible endpoints) or responses (Responses-capable endpoints).
AWWO_OPENAI_AGENTS_PROTOCOL=chat_completions
# Reasoning effort levels the default model accepts, comma-separated, a subset of
# none,minimal,low,medium,high,xhigh. Empty (the default) means the model accepts no explicit level
# and every request that names one is refused. The default level is optional display-only metadata;
# when set it must be one of the listed levels, and it is never sent on a request that did not choose one.
AWWO_OPENAI_AGENTS_REASONING_EFFORTS=
AWWO_OPENAI_AGENTS_DEFAULT_REASONING_EFFORT=
# Structured delivery output for the default model: true or false. Empty means false and any other value
# stops startup. Enable it only after staging acceptance shows this endpoint and model honour a json_schema
# response format on the protocol above, run with the staging API's AWWO_STRUCTURED_DELIVERY_CONTRACTS=true
# so that a contract is actually frozen and sent. Other profiles never inherit it; they set structuredOutput themselves.
AWWO_OPENAI_AGENTS_STRUCTURED_OUTPUT=
# These must not drop below these values, and they must match the Pi runtime: one node's output
# contract does not change with the runtime that executes it, and this worker fails a response that
# reaches the output cap closed rather than returning it. A profile that omits maxTokens inherits
# this one, so it needs a context window above 16640 or a smaller maxTokens of its own.
AWWO_OPENAI_AGENTS_CONTEXT_WINDOW=131072
AWWO_OPENAI_AGENTS_MAX_TOKENS=16384
AWWO_OPENAI_AGENTS_TIMEOUT_MS=300000
AWWO_OPENAI_AGENTS_CANCEL_GRACE_MS=2000
AWWO_OPENAI_AGENTS_MAX_CONCURRENCY=4
AWWO_OPENAI_AGENTS_MAX_OUTPUT_BYTES=1048576
# Additional profiles; default model above remains required. Keys are env references.
AWWO_OPENAI_AGENTS_MODELS_JSON=[]
# Example (set SECOND_MODEL_KEY in the private worker environment first):
# AWWO_OPENAI_AGENTS_MODELS_JSON=[{"id":"second","provider":"openai","model":"replace-model-id","baseURL":"https://models.example.invalid/v1","apiKeyEnv":"SECOND_MODEL_KEY","protocol":"responses","contextWindow":32768,"maxTokens":4096,"reasoningEfforts":["low","medium","high"],"defaultReasoningEffort":"medium"}]
# A separately named structured profile for the same upstream model. Its id must match
# ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ (a letter or digit first, then only A-Z a-z 0-9 _ . -, at most
# 128 characters; replace / and : from the provider model id). Contracts are frozen only once the
# API also sets AWWO_STRUCTURED_DELIVERY_CONTRACTS=true:
# AWWO_OPENAI_AGENTS_MODELS_JSON=[{"id":"replace-model-id-structured","name":"replace-model-id (structured)","provider":"openai","model":"replace-model-id","baseURL":"https://models.example.invalid/v1","apiKeyEnv":"SECOND_MODEL_KEY","structuredOutput":true}]
# Both this service allowlist and the internal request must select a tool.
AWWO_OPENAI_AGENTS_TOOLS_JSON=[]
# To enable the complete safe registry: ["calculator","current_time"]
# In staging/production use separate tokens/keys and HTTPS, or loopback HTTP only.
# Optional Go-side endpoint pair (belongs in API env, not this worker env):
# AWWO_OPENAI_AGENTS_URL=http://127.0.0.1:8098
# AWWO_OPENAI_AGENTS_TOKEN=<same dedicated internal token as this worker>

# Backend observability; same schema in development/staging/production.
# Independent loopback management listener. Never proxy this through the app.
AWWO_METRICS_ENABLED=false
AWWO_METRICS_LISTEN_ADDR=127.0.0.1:9103
AWWO_REVISION=unknown
AWWO_OTEL_ENABLED=false
OTEL_SERVICE_NAME=awwo-openai-agents-worker
# Self-hosted collector base endpoint; appends /v1/traces. Required when enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Blank uses 1 in development/staging, 0.05 in production; set explicitly to override.
# OTEL_TRACES_SAMPLER_ARG=0.05
# Hosted OpenAI Agents tracing remains disabled regardless of these flags.

# In user mode no shared provider API key is used. Match the API setting.
AWWO_CREDENTIAL_MODE=user
