# Private internal service token: generate at least 32 random characters.
AWWO_PI_TOKEN=
AWWO_PI_HOST=127.0.0.1
AWWO_PI_PORT=8097

# Choose openai, anthropic, or ollama. No provider is enabled by default.
AWWO_PI_PROVIDER=
AWWO_PI_MODEL=
AWWO_PI_API_KEY=
# Optional override. Defaults depend on provider; no user-submitted URLs.
AWWO_PI_BASE_URL=

AWWO_PI_TIMEOUT_MS=120000
AWWO_PI_CANCEL_GRACE_MS=2000
AWWO_PI_MAX_CONCURRENCY=4
AWWO_PI_MAX_OUTPUT_BYTES=1048576
# Configure these limits for the selected model; these are application defaults.
AWWO_PI_CONTEXT_WINDOW=32768
AWWO_PI_MAX_TOKENS=4096
