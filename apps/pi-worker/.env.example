# Private internal service token: generate at least 32 random characters.
AWWO_PI_TOKEN=
AWWO_PI_HOST=127.0.0.1
AWWO_PI_PORT=8097

# Choose openai, anthropic, or ollama. No provider is enabled by default.
AWWO_PI_PROVIDER=
AWWO_PI_MODEL=
AWWO_PI_API_KEY=
# Optional override. Defaults depend on provider; no user-submitted URLs.
AWWO_PI_BASE_URL=

# Optional additional model profiles. IDs are public selectors; secrets are
# referenced by environment variable name and never embedded in this JSON.
# Existing AWWO_PI_PROVIDER/MODEL/API_KEY still configure the default profile.
AWWO_PI_MODELS_JSON=[]
# Example JSON: [{"id":"reviewer","provider":"anthropic","model":"your-approved-model-id","apiKeyEnv":"AWWO_REVIEWER_API_KEY","contextWindow":32768,"maxTokens":4096}]
# Supply this separately for each environment if the example profile is enabled.
AWWO_REVIEWER_API_KEY=

AWWO_PI_TIMEOUT_MS=300000
AWWO_PI_CANCEL_GRACE_MS=2000
AWWO_PI_MAX_CONCURRENCY=4
AWWO_PI_MAX_OUTPUT_BYTES=1048576
# Configure these limits for the selected model; these are application defaults, and they must not
# drop below these values: a canvas plan is one long structured JSON answer, so the output cap is the
# binding limit, and at 4096 a real plan was cut off mid-string. A profile above that omits maxTokens
# inherits this one, so it needs a context window above 16640 or a smaller maxTokens of its own.
AWWO_PI_CONTEXT_WINDOW=131072
AWWO_PI_MAX_TOKENS=16384

# Backend observability; same schema in development/staging/production.
# Independent loopback management listener. Never proxy this through the app.
AWWO_METRICS_ENABLED=false
AWWO_METRICS_LISTEN_ADDR=127.0.0.1:9102
AWWO_REVISION=unknown
AWWO_OTEL_ENABLED=false
OTEL_SERVICE_NAME=awwo-pi-worker
# Self-hosted collector base endpoint; appends /v1/traces. Required when enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Blank uses 1 in development/staging, 0.05 in production; set explicitly to override.
# OTEL_TRACES_SAMPLER_ARG=0.05
# Hosted OpenAI Agents tracing remains disabled regardless of these flags.

# In user mode no shared provider API key is used. Match the API setting.
AWWO_CREDENTIAL_MODE=user
