# Private internal service token: generate at least 32 random characters.
AWWO_PI_TOKEN=
AWWO_PI_HOST=127.0.0.1
AWWO_PI_PORT=8097

# Choose openai, anthropic, or ollama. No provider is enabled by default.
AWWO_PI_PROVIDER=
AWWO_PI_MODEL=
AWWO_PI_API_KEY=
# Optional override. Defaults depend on provider; no user-submitted URLs.
AWWO_PI_BASE_URL=

# Optional additional model profiles. IDs are public selectors; secrets are
# referenced by environment variable name and never embedded in this JSON.
# Existing AWWO_PI_PROVIDER/MODEL/API_KEY still configure the default profile.
AWWO_PI_MODELS_JSON=[]
# Example JSON: [{"id":"reviewer","provider":"anthropic","model":"your-approved-model-id","apiKeyEnv":"AWWO_REVIEWER_API_KEY","contextWindow":32768,"maxTokens":4096}]
# Supply this separately for each environment if the example profile is enabled.
AWWO_REVIEWER_API_KEY=

AWWO_PI_TIMEOUT_MS=120000
AWWO_PI_CANCEL_GRACE_MS=2000
AWWO_PI_MAX_CONCURRENCY=4
AWWO_PI_MAX_OUTPUT_BYTES=1048576
# Configure these limits for the selected model; these are application defaults.
AWWO_PI_CONTEXT_WINDOW=32768
AWWO_PI_MAX_TOKENS=4096
