# Local Studio dev environment. Copy this file to .env.local and fill private values.

BACKEND_PORT=8090
FRONTEND_PORT=5174
STUDIO_CORS_ALLOW_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Optional native AI CanvasPro backend.
AI_CANVASPRO_API_BASE=http://127.0.0.1:8777
AI_CANVASPRO_AUTOSTART=auto
AI_CANVASPRO_SERVER_DIR=

# Optional SuperClaw integration used by Studio Canvas orchestration.
STUDIO_SUPERCLAW_API_BASE=http://127.0.0.1:8788
STUDIO_SUPERCLAW_GATEWAY_BASE=http://127.0.0.1:8796
STUDIO_SUPERCLAW_CONTROL_TOKEN=
STUDIO_SUPERCLAW_GATEWAY_TOKEN=
STUDIO_SUPERCLAW_ALLOW_REMOTE=0
