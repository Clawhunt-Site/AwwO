  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:canvaspro": "bash ../scripts/prepare-canvaspro-static.sh --optional",
    "dev": "npm run prepare:canvaspro && vite",
    "dev:studio": "bash ../scripts/dev.sh",
    "build": "npm run prepare:canvaspro && tsc -b && vite build",
    "preview": "vite preview",
    "smoke:studio": "node scripts/studio-frontend-smoke.mjs",
    "smoke:canvaspro": "node scripts/studio-frontend-smoke.mjs --canvaspro-only",
    "smoke:creative-director": "node scripts/creative-director-smoke.mjs",
    "generate:studio-api": "node scripts/generate-studio-api-types.mjs",
    "test:studio-session": "node --test --experimental-strip-types scripts/studio-session.test.mjs",
    "test:studio-smoke": "node --test scripts/studio-frontend-smoke.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@telegram-apps/sdk-react": "^2.0.0",
    "i18next": "^26.0.6",
