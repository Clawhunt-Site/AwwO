# Deployable builds use staging (the test server) or production. The environment is baked
# into desktop builds at compile time (npm run tauri:build:staging / :production) and is
# NOT a runtime setting. APP_ENV here is for source / docker runs and defaults to staging.
# `npm run dev` is a separate source-only development entry: it forces APP_ENV and
# VITE_APP_ENV to development and binds every local service to loopback.
APP_ENV=staging
# State DB defaults to ~/.superclaw/state.db (HOME data root, like ~/.codex / ~/.claude).
# Only set SUPERCLAW_STATE_PATH to override — do NOT point it at a cwd-relative
# ".superclaw/..." inside an iCloud-synced repo checkout (that re-introduces the
# off-machine sync the HOME default exists to avoid).
# SUPERCLAW_STATE_PATH=/absolute/path/to/state.db
SUPERCLAW_EVAL_ROOT=.superclaw/evals

# ClawHunt + relay base URLs are resolved per-environment by the kernel
# (superclaw.environment.CLAWHUNT_BASE_URLS / RELAY_BASE_URLS), selected by APP_ENV.
# The built-in per-environment values are:
#   staging     : https://staging.clawhunt.store      (ClawHunt)  | https://gate.clawhunt.site/v1 (relay)
#   production  : https://clawhunt.store                           | https://gate.clawhunt.site/v1
# Set these env vars ONLY to override the built-in default (e.g. a local ClawHunt at
# 127.0.0.1 during development, or a private relay). An explicit value always wins, so
# leave them EMPTY here — an active value would pin every environment (including a staging
# build) to it and defeat the per-environment resolution.
# Example override (uncomment to point a local dev run at a local ClawHunt):
#   CLAWHUNT_BASE_URL=http://127.0.0.1:8787
CLAWHUNT_BASE_URL=
# Node gateway upstream for browser SSO identity verification. It is deliberately
# separate from the Python kernel URL above so the gateway never guesses a
# production host. Cloud Run deploys must set this explicitly.
# Production: https://clawhunt.store
# Staging:    https://staging.clawhunt.store
SUPERCLAW_GATEWAY_CLAWHUNT_BASE_URL=
SUPERCLAW_GATEWAY_CLAWHUNT_TIMEOUT_MS=10000

# Node workspace accounts and authorization.
#
# Process and HTTP log level. This non-secret setting has the same meaning in
# development, staging and production. Allowed values are fatal, error, warn,
# info, debug, trace and silent. Unset or whitespace-only values default to
# debug, preserving the existing behavior. Use silent only for isolated
# acceptance runs where request logs must not persist.
AWWO_LOG_LEVEL=debug
#
# The tracked root example is a reference, not an automatic input to `npm run dev`.
# The local launcher reads `.local/awwo/.env` and always forces development,
# local_trusted/private, and loopback. It also generates the local Agent JWT secret.
# Do not use that launcher as a staging or production entry.
#
# Staging and production use the existing Node deployment entry
# (`pnpm -C server paperclipai run`) or the containers documented in
# `server/doc/DOCKER.md`. Copy exactly one matching profile below into that
# environment's config/secret manager. Keep secrets out of committed files.
#
# Development profile used by `npm run dev` (no Better Auth session is required):
# PAPERCLIP_DEPLOYMENT_MODE=local_trusted
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# PAPERCLIP_BIND=loopback
#
# Optional authenticated development profile. Start it through the Node deployment
# entry, not `npm run dev`, and generate two different local-only values:
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# PAPERCLIP_BIND=loopback
# PAPERCLIP_AUTH_BASE_URL_MODE=auto
# PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
# BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5188
# PAPERCLIP_ALLOWED_HOSTNAMES=127.0.0.1,localhost
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# BETTER_AUTH_SECRET=<generate-a-development-only-session-secret>
# PAPERCLIP_AGENT_JWT_SECRET=<generate-a-different-development-agent-secret>
#
# Staging profile. Replace the reserved example host with the protected staging origin.
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=public
# PAPERCLIP_BIND=loopback
# PAPERCLIP_AUTH_BASE_URL_MODE=explicit
# PAPERCLIP_PUBLIC_URL=https://staging.awwo.example
# BETTER_AUTH_TRUSTED_ORIGINS=https://staging.awwo.example
# PAPERCLIP_ALLOWED_HOSTNAMES=staging.awwo.example
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# BETTER_AUTH_SECRET=<inject-a-unique-staging-session-secret>
# PAPERCLIP_AGENT_JWT_SECRET=<inject-a-different-staging-agent-secret>
#
# Production profile. Replace the reserved example host with the production origin.
# Keep signup enabled while brand-new invitees must create their workspace account;
# set it to true only after a separate trusted provisioning path exists.
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=public
# PAPERCLIP_BIND=loopback
# PAPERCLIP_AUTH_BASE_URL_MODE=explicit
# PAPERCLIP_PUBLIC_URL=https://awwo.example
# BETTER_AUTH_TRUSTED_ORIGINS=https://awwo.example
# PAPERCLIP_ALLOWED_HOSTNAMES=awwo.example
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# BETTER_AUTH_SECRET=<inject-a-unique-production-session-secret>
# PAPERCLIP_AGENT_JWT_SECRET=<inject-a-different-production-agent-secret>

# Override the per-environment LLMgate model relay endpoint (OpenAI/Anthropic-
# compatible /v1). Leave unset to use the baked default for APP_ENV.
SUPERCLAW_RELAY_BASE_URL=
# Set in local env or secret manager only. Do not commit real values.
CLAWHUNT_AGENT_API_KEY=

# Optional governed Pay-Switch tooling. Leave unset for ordinary runs.
PAYSWITCH_BASE_URL=
PAYSWITCH_PAYMENT_INTENT_URL=
PAYSWITCH_AGENT_TOKEN=

# Local web-app -> local API server link (always local in dev).
SUPERCLAW_API_BASE_URL=http://127.0.0.1:8788
VITE_APP_ENV=staging
VITE_SUPERCLAW_API_BASE_URL=http://127.0.0.1:8788
# Fusion preview daemons are local-only and already default to localhost when running
# from source (the kernel and the Vite dev server fall back to 127.0.0.1 automatically).
# Leave these EMPTY — an active value here would pin every environment (including a
# staging/production build) to localhost. Uncomment ONLY to override:
#   SUPERCLAW_FUSION_OSIRIS_URL=http://127.0.0.1:3000
#   SUPERCLAW_FUSION_OPEN_DESIGN_URL=http://127.0.0.1:3001
#   SUPERCLAW_FUSION_OPENPENCIL_URL=http://127.0.0.1:3002
#   VITE_SUPERCLAW_FUSION_OSIRIS_URL=http://127.0.0.1:3000
#   VITE_SUPERCLAW_FUSION_OPEN_DESIGN_URL=http://127.0.0.1:3001
#   VITE_SUPERCLAW_FUSION_OPENPENCIL_URL=http://127.0.0.1:3002

# Optional eval overrides for comparing installed local CLIs.
SUPERCLAW_EVAL_CLAUDE_EXECUTABLE=
SUPERCLAW_EVAL_CODEX_EXECUTABLE=
SUPERCLAW_EVAL_AGENT_MAX_BUDGET_USD=0.25

# Optional model-provider endpoint overrides.
SUPERCLAW_GEMINI_BASE_URL=
SUPERCLAW_ANTHROPIC_BASE_URL=

# Optional RunningHub media generation. Store real keys in a local env file or
# secret manager only; multiple keys rotate round-robin at request time.
SUPERCLAW_RUNNINGHUB_API_KEYS=
# RunningHub base URL. Defaults to the localhost dev mock (http://127.0.0.1:8790) only
# when running from source; a distributed build is fail-closed and needs the real URL.
# Leave EMPTY unless overriding — an active localhost value would pin a build to it.
#   SUPERCLAW_RUNNINGHUB_BASE_URL=http://127.0.0.1:8790
SUPERCLAW_RUNNINGHUB_BASE_URL=
# Optional JSON override for RunningHub standard API endpoints/field defaults or
# legacy WebApp node ids from RunningHub API detail pages.
SUPERCLAW_RUNNINGHUB_MEDIA_TEMPLATES_JSON=

# Desktop app: how long the launcher waits for the spawned backend to answer
# /health before giving up (seconds). The shipped ad-hoc-signed frozen onefile
# pays a one-time macOS Gatekeeper dylib assessment on first COLD launch that can
# exceed the old 10s budget; the default is now 60s. Override here only to tune
# (e.g. a slow disk / heavily contended host). Empty = built-in default (60).
SUPERCLAW_DESKTOP_BOOT_TIMEOUT=
