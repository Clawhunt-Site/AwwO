APP_ENV=development
AWWO_DATABASE_URL=postgres://awwo:REPLACE_LOCAL_PASSWORD@127.0.0.1:55483/awwo?sslmode=disable
AWWO_LISTEN_ADDR=127.0.0.1:8087
AWWO_PUBLIC_ORIGIN=http://127.0.0.1:5189
AWWO_PI_URL=http://127.0.0.1:8097
AWWO_PI_TOKEN=REPLACE_WITH_SHARED_RANDOM_TOKEN_AT_LEAST_32_CHARS
AWWO_OPENAI_AGENTS_URL=http://127.0.0.1:8098
AWWO_OPENAI_AGENTS_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARS
# Freeze structured delivery contracts for nodes whose model advertises the capability.
# true/false; empty means off. See docs/awwo-openai-agents-runtime.md before enabling.
AWWO_STRUCTURED_DELIVERY_CONTRACTS=
AWWO_SESSION_TTL=24h
AWWO_RUN_TIMEOUT=180s
AWWO_PI_SESSION_WAIT=5s
AWWO_AUTH_REQUESTS_PER_MINUTE=10
AWWO_TRUSTED_PROXY_CIDRS=
AWWO_BOOTSTRAP_ADMIN_EMAIL=
AWWO_BOOTSTRAP_ADMIN_PASSWORD=
# Staging and production use the same names, isolated resources, HTTPS origins,
# and runtime secrets. See the root deployment templates and documentation.

# Backend observability; disabled unless explicitly enabled. Separate from :8087.
# Literal loopback IP only. Never publish this management listener through ingress.
AWWO_METRICS_ENABLED=false
AWWO_METRICS_LISTEN_ADDR=127.0.0.1:9101
AWWO_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=awwo-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Omit for environment default: development/staging=1; production=0.05.
# OTEL_TRACES_SAMPLER_ARG=1
# Optional API attributes must match APP_ENV / compiled build revision exactly.
OTEL_RESOURCE_ATTRIBUTES=
# Empty means no configured prices; token usage may still be reported.
# Rates are explicit integer micro-USD per million tokens, stored as JSON strings.
# See docs/awwo-backend-observability.md for the versioned schema; do not invent prices.
AWWO_MODEL_PRICING_JSON=
# Validated policy setting (31..3650). Automatic ledger deletion is NOT implemented.
AWWO_USAGE_RETENTION_DAYS=180

# Personal credentials (recommended). Keep this encryption key stable across restarts.
AWWO_CREDENTIAL_MODE=user
# Set true only when all API and worker services use the same Gate-only policy.
AWWO_LLMGATE_ONLY=false
# Generate with: openssl rand -base64 32
AWWO_CREDENTIAL_ENCRYPTION_KEY=
# Optional password-recovery mail; TLS is mandatory (465 or 587).
AWWO_SMTP_HOST=
AWWO_SMTP_PORT=587
AWWO_SMTP_USERNAME=
AWWO_SMTP_PASSWORD=
AWWO_SMTP_FROM=
