{
  "name": "awwo",
  "version": "0.9.0",
  "author": {
    "name": "Boxpo",
    "url": "https://github.com/Boxpo"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:saas": "node scripts/awwo-saas-setup.mjs",
    "dev:saas": "node scripts/awwo-saas-dev.mjs",
    "build:saas": "npm run build:saas --prefix apps/web",
    "test:saas:scripts": "node --test scripts/awwo-saas-scripts.test.mjs",
    "test:saas:pi": "npm test --prefix apps/pi-worker",
    "test:saas:openai-agents": "npm test --prefix apps/openai-agents-worker",
    "test:saas:backend": "node scripts/awwo-saas-test-backend.mjs",
    "test:saas:smoke": "node scripts/awwo-saas-smoke.mjs",
    "test:saas:stack": "node --test scripts/awwo-saas-stack.test.mjs",
    "test:saas:render": "npm test --prefix apps/render-worker",
    "test:saas:engineering": "node --test scripts/check-source-hygiene.test.mjs scripts/awwo-doctor.test.mjs scripts/build-skill-licences.test.mjs",
    "check:hygiene": "node scripts/check-source-hygiene.mjs",
    "check:skill-licences": "node scripts/build-skill-licences.mjs --check",
    "check:go-licences": "node scripts/awwo-go-licences.ts --check",
    "doctor:saas": "node scripts/awwo-doctor.mjs",
    "check:market:wshobson": "node scripts/export-awwo-wshobson-market.ts --check",
    "setup": "node scripts/awwo-setup.mjs",
    "dev": "node scripts/awwo-dev.mjs",
    "test:scripts": "node --test scripts/awwo-scripts.test.mjs",
    "test:web": "npm test --prefix apps/web",
    "test:gateway": "npm test --prefix apps/gateway",
    "build:web": "npm run build --prefix apps/web",
    "build:gateway": "npm run build --prefix apps/gateway",
    "start:user": "node scripts/awwo-user-start.ts",
    "setup:local": "node scripts/awwo-local-setup.mjs",
    "local": "node scripts/awwo-local.mjs",
    "package:local": "node scripts/awwo-local-package.mjs",
    "test:local": "node --test scripts/awwo-local.test.mjs scripts/awwo-local-web.test.mjs scripts/awwo-local-package.test.mjs scripts/awwo-local-licences.test.mjs",
    "test:user-models": "node --test apps/user-models.test.ts",
    "test:saas:bedrock": "node --test apps/bedrock-bridge.test.ts apps/bedrock-catalog.test.ts",
    "build:windows": "node apps/windows/build.ts",
    "test:windows": "node --test apps/windows/config.test.ts",
    "test:saas:computer-model": "node --test apps/computer-model.test.ts",
    "test:saas:openmaus": "npm test --prefix apps/openmaus-worker",
    "check:saas:computer-model": "node apps/openmaus-worker/node_modules/typescript/bin/tsc -p apps/tsconfig.computer-model.json"
  }
}
