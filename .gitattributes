* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pdf binary
*.png binary
*.webp binary
*.zip binary
# Force textual diff for TypeScript sources so a stray control byte can
# never make git/GitHub mislabel a source file as binary and hide its diff.
*.ts  diff
*.tsx diff

# Frozen verification records contain byte hashes. Preserve their original bytes.
docs/superpowers/evidence/** -text
examples/knowledge-workbench/docs/contracts/** -text
# Go module license files, compared byte for byte with the module cache (scripts/awwo-go-licences.ts --check).
third_party/go-modules/** -text
# Licence files fetched for AwwO 本地版's Windows installer, checked byte for byte against the SHA-256 their
# PROVENANCE.json records (scripts/awwo-crate-licences.mjs, awwo-npm-licences.mjs, awwo-postgres-licences.mjs --check).
third_party/rust-crates/** -text
third_party/npm-packages/** -text
third_party/postgres-windows/** -text
