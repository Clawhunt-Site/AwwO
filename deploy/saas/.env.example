# Copy outside Git; replace every CHANGE_ME value. No public port is opened by default.
APP_ENV=staging
AWWO_PUBLIC_ORIGIN=https://CHANGE_ME_STAGING_HOST
AWWO_INGRESS_PORT=8189
AWWO_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
# URL-encode the password. For this private Compose network host is database.
# Enforce TLS when using a managed/external PostgreSQL service.
AWWO_DATABASE_URL=postgres://awwo:CHANGE_ME_DATABASE_PASSWORD@database:5432/awwo?sslmode=disable
AWWO_PI_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARS
AWWO_OPENAI_AGENTS_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARS
AWWO_BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
AWWO_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AWWO_PI_PROVIDER=openai
AWWO_PI_MODEL=CHANGE_ME_MODEL
AWWO_PI_BASE_URL=https://CHANGE_ME_MODEL_API/v1
# For a model served by the Docker host itself use http://host.docker.internal:11434/v1, never
# 127.0.0.1, which inside the container is the container's own loopback and is also the ollama
# provider default when this is left empty. compose.yml maps that name for the Pi service only.
# Bind the model server to an address the Docker bridge reaches, and firewall its port to the
# bridge subnets: that hop carries no credential for an ollama profile.
AWWO_PI_API_KEY=CHANGE_ME_MODEL_KEY
# Optional additional model profiles; keep secret values in a private environment file.
AWWO_PI_MODELS_JSON=
AWWO_PI_PROFILES_ENV_FILE=./pi-profiles.env
# Example (replace provider/model/URL with this environment's own values):
# AWWO_PI_MODELS_JSON='[{"id":"reviewer","provider":"openai","model":"CHANGE_ME_MODEL","baseURL":"https://CHANGE_ME_MODEL_API/v1","apiKeyEnv":"AWWO_REVIEWER_API_KEY"}]'
# Put AWWO_REVIEWER_API_KEY=... in the untracked private profiles file.
# Give every profile an explicit baseURL: one that omits it inherits the provider default, so an
# ollama profile silently resolves to the container's own loopback exactly as above.
# Each admitted run's deadline is already running while it waits behind the others at a shared
# model server, so queue wait is spent out of AWWO_PI_TIMEOUT_MS. Lower this to 1 for one local GPU.
AWWO_PI_MAX_CONCURRENCY=4
# Set these to capacities supported by the actual configured model, and never below the values
# below: a canvas plan is one long structured JSON answer, so AWWO_PI_MAX_TOKENS is the binding
# limit. At 4096 a real seven-node plan (~4.5k characters, 32 operations) was cut off mid-string and
# the run failed as runtime_failed / invalid_canvas_plan. Keep max tokens + 256 < context window.
# Raising this has a consequence for AWWO_PI_MODELS_JSON: a profile that omits maxTokens inherits
# this value, and a profile is rejected unless maxTokens + 256 < its own contextWindow, so any
# profile declaring a context window at or below 16640 must now state a smaller maxTokens of its
# own. One rejected profile invalidates the whole set and leaves the worker unconfigured.
AWWO_PI_CONTEXT_WINDOW=131072
AWWO_PI_MAX_TOKENS=16384
# Timeouts must increase outward: AWWO_PI_TIMEOUT_MS < AWWO_RUN_TIMEOUT < nginx proxy_read_timeout
# (660s in ./nginx.conf). Otherwise a healthy long generation is cancelled by the shortest link
# rather than completing. Raise nginx first if you need a longer ceiling than this.
AWWO_PI_TIMEOUT_MS=300000
AWWO_RUN_TIMEOUT=600s
AWWO_PI_SESSION_WAIT=5s
# Optional OpenAI Agents runtime. Keep its provider credentials scoped to that
# worker and use environment-specific values. Go receives only URL + token.
AWWO_OPENAI_AGENTS_PROVIDER=openai
AWWO_OPENAI_AGENTS_MODEL=CHANGE_ME_MODEL
AWWO_OPENAI_AGENTS_BASE_URL=https://CHANGE_ME_MODEL_API/v1
# Outside APP_ENV=development this worker requires https, or a loopback host (127.0.0.1, [::1],
# localhost); anything else leaves it unconfigured and the API refuses the runtime. Loopback only
# satisfies that gate — inside a container it is the container itself, so it is not a way to reach a
# model on the Docker host. A host-served model must therefore be https here, which is why only Pi
# maps host.docker.internal.
AWWO_OPENAI_AGENTS_API_KEY=CHANGE_ME_MODEL_KEY
AWWO_OPENAI_AGENTS_PROTOCOL=chat_completions
AWWO_OPENAI_AGENTS_MODELS_JSON=
AWWO_OPENAI_AGENTS_TOOLS_JSON=[]
AWWO_OPENAI_AGENTS_PROFILES_ENV_FILE=./openai-agents-profiles.env
AWWO_OPENAI_AGENTS_MAX_CONCURRENCY=4
# Set these to capacities the actual configured model supports, and never below the values below.
# A node's output contract is the same whichever runtime executes it, and this worker fails a
# response that hits the output cap closed as MODEL_OUTPUT_LIMIT rather than truncating it, so an
# output cap under the Pi one makes the same deliverable fail here and succeed there. The context
# window carries the output cap: admitted input is context window - max tokens - 256, so raising
# max tokens alone would reject prompts this deployment accepts today.
# AWWO_OPENAI_AGENTS_MODELS_JSON inherits this the same way AWWO_PI_MODELS_JSON does: a profile that
# omits maxTokens must declare a context window above 16640 or state its own smaller maxTokens, and
# one rejected profile invalidates the whole set.
AWWO_OPENAI_AGENTS_CONTEXT_WINDOW=131072
AWWO_OPENAI_AGENTS_MAX_TOKENS=16384
# The deadline has to rise with the envelope for the same reason it did for Pi: a 16384-token answer
# cannot be produced inside a budget sized for a 4096-token one, and this worker fails such a run
# closed rather than returning what it had. Stays under AWWO_RUN_TIMEOUT and nginx's 660s.
AWWO_OPENAI_AGENTS_TIMEOUT_MS=300000
AWWO_OPENAI_AGENTS_CANCEL_GRACE_MS=2000
AWWO_OPENAI_AGENTS_MAX_OUTPUT_BYTES=1048576
# Exact trusted proxy IPs/CIDRs, comma-separated. Empty ignores forwarded headers.
# Before public use, include the actual nginx and outer ingress addresses only.
# The outer ingress must append the observed client IP, never pass a client-only chain.
AWWO_TRUSTED_PROXY_CIDRS=

# Backend instrumentation only. compose.yml forwards these to API / both workers.
# Collectors, dashboards, scrape topology and production rollout are separate work.
AWWO_METRICS_ENABLED=false
# API only. Workers use 127.0.0.1:9102 and :9103 in their own containers.
# Management listeners stay on container loopback; no management port is published.
AWWO_METRICS_LISTEN_ADDR=127.0.0.1:9101
AWWO_OTEL_ENABLED=false
# Self-hosted internal collector; HTTPS required off loopback in staging/production.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Compose explicitly defaults to 0.05 in every environment; override for acceptance.
OTEL_TRACES_SAMPLER_ARG=0.05
# Worker build metadata only; API revision comes from its compiled build.
AWWO_REVISION=unknown
# API-only versioned pricing. Empty means unavailable estimated cost, not free usage.
AWWO_MODEL_PRICING_JSON=
# Policy value only (31..3650); no automatic cleanup scheduler in this delivery.
AWWO_USAGE_RETENTION_DAYS=180
# Service names are fixed by Compose. Arbitrary resource attributes, OTLP headers
# and HMAC key files are not forwarded by this template. See the backend guide.
