# Copy to a secure path outside Git. Set every CHANGE_ME value before startup.
APP_ENV=production
AWWO_PUBLIC_ORIGIN=https://CHANGE_ME_PUBLIC_HOST
AWWO_INGRESS_PORT=8189
AWWO_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
# URL-encode the password. Use TLS for external/managed PostgreSQL.
AWWO_DATABASE_URL=postgres://awwo:CHANGE_ME_DATABASE_PASSWORD@database:5432/awwo?sslmode=disable
AWWO_PI_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARS
AWWO_OPENAI_AGENTS_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARS
AWWO_BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
AWWO_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# All API/workers must agree. Users supply personal provider keys after login.
AWWO_CREDENTIAL_MODE=user
# Generate once: openssl rand -base64 32
# Keep this stable and backed up with your database. Never commit it.
AWWO_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Optional password recovery. Register/login work without SMTP; recovery reports
# unavailability until this is configured. Sender must be verified by your provider.
AWWO_SMTP_HOST=
AWWO_SMTP_PORT=587
AWWO_SMTP_FROM=
AWWO_SMTP_USERNAME=
AWWO_SMTP_PASSWORD=

AWWO_PI_MAX_CONCURRENCY=4
AWWO_OPENAI_AGENTS_MAX_CONCURRENCY=4
# Legacy operator-mode capacities. Personal connections use the conservative
# envelope documented in docs/personal-accounts.md instead of shared profiles.
AWWO_PI_CONTEXT_WINDOW=131072
AWWO_PI_MAX_TOKENS=16384
AWWO_OPENAI_AGENTS_CONTEXT_WINDOW=131072
AWWO_OPENAI_AGENTS_MAX_TOKENS=16384
AWWO_PI_TIMEOUT_MS=300000
AWWO_OPENAI_AGENTS_TIMEOUT_MS=300000
AWWO_RUN_TIMEOUT=600s
AWWO_PI_SESSION_WAIT=5s
AWWO_OPENAI_AGENTS_TOOLS_JSON=[]

# Exact ingress IPs/CIDRs only. Empty ignores forwarded headers.
AWWO_TRUSTED_PROXY_CIDRS=
AWWO_METRICS_ENABLED=false
AWWO_OTEL_ENABLED=false
AWWO_REVISION=unknown
AWWO_MODEL_PRICING_JSON=
AWWO_USAGE_RETENTION_DAYS=180

# Legacy operator mode is opt-in and documented in docs/personal-accounts.md.
# Do not put shared provider keys in a personal-mode deployment.
